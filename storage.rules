rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function editor() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/adminRoles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/adminRoles/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/adminRoles/$(request.auth.uid)).data.role in ['owner','editor'];
    }
    match /site-media/{uid}/{filename} {
      allow read: if true;
      allow create: if editor() && request.auth.uid == uid
        && ((request.resource.contentType == 'image/webp' && request.resource.size <= 2 * 1024 * 1024)
        || (request.resource.contentType == 'video/mp4' && request.resource.size <= 20 * 1024 * 1024));
      allow update, delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
