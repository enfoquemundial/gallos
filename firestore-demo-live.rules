rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll([
          'uid', 'displayName', 'email', 'whatsapp',
          'notificationsConsent', 'consentVersion',
          'consentAt', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'uid', 'displayName', 'email', 'whatsapp',
          'notificationsConsent', 'consentVersion',
          'consentAt', 'createdAt', 'updatedAt'
        ])
        && d.uid == uid
        && d.displayName is string
        && d.displayName.size() > 0
        && d.displayName.size() <= 100
        && d.email == request.auth.token.email
        && d.whatsapp is string
        && d.whatsapp.matches('^([0-9]{7,15}|[+][1-9][0-9]{7,14})$')
        && d.notificationsConsent == true
        && d.consentVersion == 'live-notifications-v1'
        && d.consentAt == request.time
        && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if owner() && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // DEMOSTRACION: ofertas sin dinero, sin saldos y sin premios.
    match /demoRooms/{room}/offers/{offer} {
      function demoUser() { return request.auth != null; }
      function demoFields() {
        let d = request.resource.data;
        return d.keys().hasAll(['mode','makerUid','takerUid','side','stake','opponentStake','status','createdAt','updatedAt','expiresAt'])
          && d.keys().hasOnly(['mode','makerUid','takerUid','side','stake','opponentStake','status','createdAt','updatedAt','expiresAt']);
      }
      allow get: if demoUser();
      allow list: if demoUser() && request.query.limit != null && request.query.limit <= 50;
      allow create: if demoUser() && demoFields()
        && room.matches('^[a-z0-9-]{1,90}$')
        && request.resource.data.mode == 'demo'
        && request.resource.data.makerUid == request.auth.uid
        && request.resource.data.takerUid == ''
        && request.resource.data.side in ['white','blue']
        && request.resource.data.stake is int
        && request.resource.data.stake in [100,500,1000]
        && request.resource.data.opponentStake is int
        && request.resource.data.opponentStake in [request.resource.data.stake,request.resource.data.stake / 2]
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15,'m');
      allow update: if demoUser() && demoFields()
        && resource.data.mode == 'demo'
        && resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.makerUid == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
          ||
          (resource.data.makerUid != request.auth.uid
            && resource.data.expiresAt > request.time
            && request.resource.data.takerUid == request.auth.uid
            && request.resource.data.status == 'matched'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','takerUid','updatedAt']))
        );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
