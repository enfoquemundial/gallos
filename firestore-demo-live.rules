rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll([
          'uid', 'displayName', 'email', 'whatsapp',
          'notificationsConsent', 'consentVersion',
          'consentAt', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'uid', 'displayName', 'email', 'whatsapp',
          'notificationsConsent', 'consentVersion',
          'consentAt', 'createdAt', 'updatedAt'
        ])
        && d.uid == uid
        && d.displayName is string
        && d.displayName.size() > 0
        && d.displayName.size() <= 100
        && d.email == request.auth.token.email
        && d.whatsapp is string
        && d.whatsapp.matches('^([0-9]{7,15}|[+][1-9][0-9]{7,14})$')
        && d.notificationsConsent == true
        && d.consentVersion == 'live-notifications-v1'
        && d.consentAt == request.time
        && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if owner() && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // DEMO: empareja dos ofertas opuestas sin saldos ni dinero real.
    match /demoRooms/{room}/offers/{offer} {
      function demoUser() { return request.auth != null; }
      function demoFields() {
        let d = request.resource.data;
        return d.keys().hasAll(['mode','makerUid','takerUid','side','stake','opponentStake','status','createdAt','updatedAt','expiresAt'])
          && d.keys().hasOnly(['mode','makerUid','takerUid','side','stake','opponentStake','status','createdAt','updatedAt','expiresAt','pairedWith','makerName','opponentName'])
          && d.get('makerName','') is string && d.get('makerName','').size() <= 100
          && d.get('opponentName','') is string && d.get('opponentName','').size() <= 100
          && d.mode == 'demo' && d.side in ['white','blue']
          && d.makerUid is string && d.takerUid is string
          && d.stake is int && d.opponentStake is int
          && d.stake in [50,100,250,500,1000]
          && d.opponentStake in [50,100,250,500,1000]
          && d.get('pairedWith','') is string && d.get('pairedWith','').size() <= 100;
      }
      function validPair() {
        let d = request.resource.data;
        let paired = d.get('pairedWith','');
        let path = /databases/$(database)/documents/demoRooms/$(room)/offers/$(paired);
        let other = getAfter(path).data;
        return paired != '' && paired != offer
          && other.mode == 'demo' && other.status == 'matched'
          && other.pairedWith == offer
          && other.makerUid == d.takerUid && other.takerUid == d.makerUid
          && d.makerName == get(/databases/$(database)/documents/users/$(d.makerUid)).data.displayName
          && d.opponentName == other.makerName && other.opponentName == d.makerName
          && d.makerUid != other.makerUid
          && request.auth.uid in [d.makerUid,other.makerUid]
          && other.side != d.side
          && other.stake == d.opponentStake && other.opponentStake == d.stake
          && d.expiresAt > request.time && other.expiresAt > request.time
          && other.updatedAt == request.time
          && ((!exists(path) && other.makerUid == request.auth.uid)
            || (exists(path) && get(path).data.status == 'open'));
      }
      allow get: if demoUser();
      allow list: if demoUser() && request.query.limit != null && request.query.limit <= 50;
      allow create: if demoUser() && demoFields()
        && room.matches('^[a-z0-9-]{1,90}$')
        && request.resource.data.makerUid == request.auth.uid
        && request.resource.data.makerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15,'m')
        && (
          (request.resource.data.status == 'open'
            && request.resource.data.takerUid == ''
            && request.resource.data.opponentName == ''
            && request.resource.data.get('pairedWith','') == ''
            && request.resource.data.stake in [100,500,1000]
            && request.resource.data.opponentStake in [request.resource.data.stake,request.resource.data.stake / 2])
          || (request.resource.data.status == 'matched' && validPair())
        );
      allow update: if demoUser() && demoFields()
        && resource.data.mode == 'demo' && resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.makerUid == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
          ||
          (request.resource.data.status == 'matched'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','takerUid','pairedWith','opponentName','updatedAt'])
            && validPair())
        );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
