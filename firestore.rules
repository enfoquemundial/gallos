rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function teamRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.active == true
        ? get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role : '';
    }
    function ownerAdmin() { return teamRole() == 'owner'; }
    function editorAdmin() { return teamRole() in ['owner', 'editor']; }
    function operatorAdmin() { return teamRole() in ['owner', 'operator']; }
    function stamp() { return request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time; }
    match /adminRoles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || ownerAdmin());
      allow list: if ownerAdmin();
      allow create, update: if ownerAdmin() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['email','role','active','updatedBy','updatedAt'])
        && request.resource.data.role in ['owner','editor','operator']
        && request.resource.data.active is bool
        && request.resource.data.email is string
        && request.resource.data.email == get(/databases/$(database)/documents/users/$(uid)).data.email
        && stamp();
      allow delete: if false;
    }
    match /siteContent/main {
      function validContent() {
        return request.resource.data.keys().hasOnly(['media','version','updatedBy','updatedAt'])
          && request.resource.data.media is map && request.resource.data.media.size() <= 150
          && request.resource.data.version is int && stamp();
      }
      allow get: if true;
      allow list, delete: if false;
      allow create: if editorAdmin() && validContent() && request.resource.data.version == 1;
      allow update: if editorAdmin() && validContent() && request.resource.data.version == resource.data.version + 1;
    }
    match /liveEvents/main {
      function validEvent() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title','city','venue','startsAt','liveInputUid','state','version','updatedBy','updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.city is string && d.city.size() <= 80
          && d.venue is string && d.venue.size() <= 120
          && d.startsAt is string && d.startsAt.size() <= 40
          && d.state in ['scheduled','live','ended'] && d.liveInputUid is string
          && (d.liveInputUid == '' || d.liveInputUid.matches('^[a-zA-Z0-9_-]{12,128}$'))
          && (d.state != 'live' || d.liveInputUid.size() >= 12)
          && d.version is int && stamp();
      }
      allow get: if request.auth != null;
      allow list, delete: if false;
      allow create: if operatorAdmin() && validEvent() && request.resource.data.version == 1;
      allow update: if operatorAdmin() && validEvent() && request.resource.data.version == resource.data.version + 1;
    }
    match /adminAudit/{id} {
      allow read: if teamRole() in ['owner','editor','operator'];
      allow create: if teamRole() in ['owner','editor','operator']
        && request.resource.data.keys().hasOnly(['actor','action','target','createdAt'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.action is string && request.resource.data.action.size() <= 160
        && request.resource.data.target is string && request.resource.data.target.size() <= 160
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll([
          'uid', 'displayName', 'email', 'whatsapp',
          'notificationsConsent', 'consentVersion',
          'consentAt', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'uid', 'displayName', 'email', 'whatsapp',
          'notificationsConsent', 'consentVersion',
          'consentAt', 'createdAt', 'updatedAt'
        ])
        && d.uid == uid
        && d.displayName is string
        && d.displayName.size() > 0
        && d.displayName.size() <= 100
        && d.email == request.auth.token.email
        && d.whatsapp is string
        && d.whatsapp.matches('^([0-9]{7,15}|[+][1-9][0-9]{7,14})$')
        && d.notificationsConsent == true
        && d.consentVersion == 'live-notifications-v1'
        && d.consentAt == request.time
        && d.updatedAt == request.time;
      }
      allow get: if owner() || ownerAdmin();
      allow list: if ownerAdmin();
      allow delete: if false;
      allow create: if owner() && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if owner() && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // DEMO: empareja dos ofertas opuestas sin saldos ni dinero real.
    match /demoRooms/{room}/offers/{offer} {
      function demoUser() { return request.auth != null; }
      function demoFields() {
        let d = request.resource.data;
        return d.keys().hasAll(['mode','makerUid','takerUid','side','stake','opponentStake','status','createdAt','updatedAt','expiresAt'])
          && d.keys().hasOnly(['mode','makerUid','takerUid','side','stake','opponentStake','status','createdAt','updatedAt','expiresAt','pairedWith'])
          && d.mode == 'demo' && d.side in ['white','blue']
          && d.makerUid is string && d.takerUid is string
          && d.stake is int && d.opponentStake is int
          && d.stake in [50,100,250,500,1000]
          && d.opponentStake in [50,100,250,500,1000]
          && d.get('pairedWith','') is string && d.get('pairedWith','').size() <= 100;
      }
      function validPair() {
        let d = request.resource.data;
        let paired = d.get('pairedWith','');
        let path = /databases/$(database)/documents/demoRooms/$(room)/offers/$(paired);
        let other = getAfter(path).data;
        return paired != '' && paired != offer
          && other.mode == 'demo' && other.status == 'matched'
          && other.pairedWith == offer
          && other.makerUid == d.takerUid && other.takerUid == d.makerUid
          && d.makerUid != other.makerUid
          && request.auth.uid in [d.makerUid,other.makerUid]
          && other.side != d.side
          && other.stake == d.opponentStake && other.opponentStake == d.stake
          && d.expiresAt > request.time && other.expiresAt > request.time
          && other.updatedAt == request.time
          && ((!exists(path) && other.makerUid == request.auth.uid)
            || (exists(path) && get(path).data.status == 'open'));
      }
      allow get: if demoUser();
      allow list: if demoUser() && request.query.limit != null && request.query.limit <= 50;
      allow create: if demoUser() && demoFields()
        && room.matches('^[a-z0-9-]{1,90}$')
        && request.resource.data.makerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15,'m')
        && (
          (request.resource.data.status == 'open'
            && request.resource.data.takerUid == ''
            && request.resource.data.get('pairedWith','') == ''
            && request.resource.data.stake in [100,500,1000]
            && request.resource.data.opponentStake in [request.resource.data.stake,request.resource.data.stake / 2])
          || (request.resource.data.status == 'matched' && validPair())
        );
      allow update: if demoUser() && demoFields()
        && resource.data.mode == 'demo' && resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.makerUid == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
          ||
          (request.resource.data.status == 'matched'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','takerUid','pairedWith','updatedAt'])
            && validPair())
        );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

