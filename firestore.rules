rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll(['uid', 'displayName', 'email', 'whatsapp', 'notificationsConsent', 'consentVersion', 'consentAt', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['uid', 'displayName', 'email', 'whatsapp', 'notificationsConsent', 'consentVersion', 'consentAt', 'createdAt', 'updatedAt'])
          && d.uid == uid
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 100
          && d.email == request.auth.token.email
          && d.whatsapp is string && d.whatsapp.matches('^[+][1-9][0-9]{7,14}$')
          && d.notificationsConsent == true
          && d.consentVersion == 'live-notifications-v1'
          && d.consentAt == request.time && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner() && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
